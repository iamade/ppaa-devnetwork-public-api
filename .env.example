# PPAA Agent Showcase (PP-79) - local/staging configuration
# Copy to .env and adjust. All services bind to 127.0.0.1 only.
# Host ports avoid base 5432/6379 collisions (per PP-83 delivery rule).

APP_PORT=8005
WEB_PORT=5174

# Container-internal service hosts used by the app
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=ppaa
POSTGRES_PASSWORD=ppaa_local
POSTGRES_DB=ppaa_showcase

REDIS_HOST=redis
REDIS_PORT=6379

# Host-side published ports for postgres/redis (non-default, loopback only)
POSTGRES_HOST_PORT=25432
REDIS_HOST_PORT=26379

# CORS origins allowed to call the API from the static frontend
ALLOWED_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
